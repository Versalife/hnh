---
/**
 * Right-margin reference note. Numbers are assigned automatically by CSS
 * counter in document order — no need to pass n.
 *
 * Inline (no block content):
 *   <Sidenote>Some marginal commentary.</Sidenote>
 *
 * With code blocks — use SidenoteRef inline, then Sidenote noRef as a block:
 *   text<SidenoteRef /> continues.
 *
 *   <Sidenote noRef>
 *
 *   Content with ```code blocks``` here.
 *
 *   </Sidenote>
 *
 * Reference with linked title and citation:
 *   <Sidenote href="https://..." citation="Taori et al, 2021">
 *     Alpaca: A Strong, Replicable Instruction-Following Model
 *   </Sidenote>
 *
 * Unnumbered margin note:
 *   <Sidenote unnumbered>Note text here.</Sidenote>
 */
interface Props {
  n?: number;       // ignored — kept for backward compat only
  href?: string;
  citation?: string;
  noRef?: boolean;
  unnumbered?: boolean;
}

const { href, citation, noRef = false, unnumbered = false } = Astro.props;
---

{!noRef && <sup class="sidenote-ref"></sup>}<span class="sidenote">{!unnumbered && <span class="sidenote-num"></span>}{href
  ? <a href={href}><slot /></a>
  : <slot />}{citation && <span class="sidenote-citation">{citation}</span>}</span>
