---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const showDrafts = import.meta.env.DEV && process.env.HIDE_DRAFTS !== 'true';
const allPosts = (await getCollection('writing', ({ data }) => showDrafts || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const postsWithMeta = allPosts.map(post => ({
  post,
  rt: readingTime(post.body).text,
}));
---

<BaseLayout title="Writing" description="All essays and technical notes.">
  <main class="page-main">
    <h1 style="font-size: 1.5rem; margin-bottom: 0.25rem;">Writing</h1>
    <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 2rem;">
      Essays and technical notes.
    </p>

    <ol class="post-list" reversed start={allPosts.length}>
      {postsWithMeta.map(({ post, rt }) => (
        <li class="post-list-item">
          <span class="post-date">
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
          </span>
          <span class="post-title">
            <a href={`${base}/writing/${post.id}`}>{post.data.title}</a>
            {post.data.draft && <span class="draft-badge">draft</span>}
          </span>
          <span class="post-reading-time">{rt}</span>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>

<style>
  .page-main {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .draft-badge {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.65rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.1em 0.4em;
    vertical-align: middle;
  }

  @media (max-width: 760px) {
    .page-main {
      padding: 2rem 1rem;
    }
  }
</style>
